#!/usr/bin/env bash

# Discover PRJ_ROOT if not found via git (i.e. not in a git repository).
# Look for the .config folder in the current directory and up
find_prj_config() (
	local old_pwd
	while [[ $old_pwd != "$PWD" ]]; do
		if [[ -d .config && "$HOME" != "$PWD" ]]; then
			echo "$PWD"
			return 0
		fi
		old_pwd=$PWD
		cd ..
	done
	# We're at the top and didn't find anything
	log_error "ERROR: could not find project root" >&2
	return 1
)

# Discover PRJ_ROOT if in a git repository.
find_prj_root_with_git() (
	git rev-parse --show-toplevel 2>/dev/null
)

{
	: "${XDG_CONFIG_HOME:=${HOME}/.config}"
	: "${XDG_CACHE_HOME:=${HOME}/.cache}"
	: "${XDG_DATA_HOME:=${HOME}/.local/share}"

	# PRJ_ROOT
	_prj_root="$(find_prj_root_with_git)"
	: "${PRJ_ROOT:=${_prj_root:=$(find_prj_config)}}"

	# PRJ_CONFIG_HOME - always local to the project
	: "${PRJ_CONFIG_HOME:=${PRJ_ROOT}/.config}"
	mkdir -p "${PRJ_CONFIG_HOME}"

	if [[ -z "${PRJ_ID:-}" && -f "${PRJ_CONFIG_HOME}/prj_id" ]]; then
		PRJ_ID=$(<"${PRJ_CONFIG_HOME}/prj_id")
	fi

	# PRJ_RUNTIME_DIR - always local to the project
	: "${PRJ_RUNTIME_DIR:=${PRJ_ROOT}/.run}"
	mkdir -p "${PRJ_RUNTIME_DIR}"

	# PRJ_CACHE_HOME - shared if PRJ_ID is set
	if [[ -z "${PRJ_CACHE_HOME:-}" ]]; then
		if [[ -n "${PRJ_ID:-}" ]]; then
			PRJ_CACHE_HOME="${XDG_CACHE_HOME}/prj/${PRJ_ID}"
		else
			PRJ_CACHE_HOME="${PRJ_ROOT}/.cache"
		fi
	fi
	mkdir -p "${PRJ_CACHE_HOME}"

	# PRJ_DATA_HOME - shared if PRJ_ID is set
	if [[ -z "${PRJ_DATA_HOME:-}" ]]; then
		if [[ -n "${PRJ_ID:-}" ]]; then
			PRJ_DATA_HOME="${XDG_DATA_HOME}/prj/${PRJ_ID}"
		else
			PRJ_DATA_HOME="${PRJ_ROOT}/.data"
		fi
	fi
	mkdir -p "${PRJ_DATA_HOME}"

	# PRJ_PATH - shared if PRJ_ID is set
	if [[ -z "${PRJ_PATH:-}" ]]; then
		if [[ -n "${PRJ_ID:-}" ]]; then
			PRJ_PATH="${HOME}/.local/bin/prj/${PRJ_ID}"
		else
			PRJ_PATH="${PRJ_ROOT}/.bin"
		fi
	fi
	mkdir -p "${PRJ_PATH}"
}

unset -f find_prj_config

PATH_add "${PRJ_PATH}"
export PRJ_ROOT
export PRJ_ID
export PRJ_PATH
export PRJ_CONFIG_HOME
export PRJ_CACHE_HOME
export PRJ_DATA_HOME
export PRJ_RUNTIME_DIR

_prj_direnv_silence_requested() {
	case "${DIRENV_SILENCE:-}" in
		0 | false | FALSE | no | NO | off | OFF)
			unset DIRENV_PRJ_SILENCE DIRENV_LOG_FORMAT
			return 1
			;;
		1 | true | TRUE | yes | YES | on | ON) return 0 ;;
	esac

	[[ -n "${CLAUDE_CODE_SESSION_ID:-}" || -n "${CODEX_THREAD_ID:-}" ]]
}

# Agent sessions should not add project status noise to command output.
if _prj_direnv_silence_requested; then
	export DIRENV_SILENCE="${DIRENV_SILENCE:-1}"
	export DIRENV_PRJ_SILENCE=1
	export DIRENV_LOG_FORMAT=
fi

unset -f _prj_direnv_silence_requested

[ -z ${DIRENV_PRJ_SILENCE+x} ] && log_status "PRJ_ROOT:        ${PRJ_ROOT}"
[ -z ${DIRENV_PRJ_SILENCE+x} ] && log_status "PRJ_ID:          ${PRJ_ID-none}"
[ -z ${DIRENV_PRJ_SILENCE+x} ] && log_status "PRJ_CONFIG_HOME: ${PRJ_CONFIG_HOME#"${PRJ_ROOT}"/}"
[ -z ${DIRENV_PRJ_SILENCE+x} ] && log_status "PRJ_RUNTIME_DIR: ${PRJ_RUNTIME_DIR#"${PRJ_ROOT}"/}"
[ -z ${DIRENV_PRJ_SILENCE+x} ] && log_status "PRJ_CACHE_HOME:  ${PRJ_CACHE_HOME#"${PRJ_ROOT}"/}"
[ -z ${DIRENV_PRJ_SILENCE+x} ] && log_status "PRJ_DATA_HOME:   ${PRJ_DATA_HOME#"${PRJ_ROOT}"/}"
[ -z ${DIRENV_PRJ_SILENCE+x} ] && log_status "PRJ_PATH:        ${PRJ_PATH#"${PRJ_ROOT}"/}"

# shellcheck disable=SC2034
direnv_layout_dir="${PRJ_DATA_HOME}/direnv"

_prj_write_devenv_profile_exec() {
	local launcher launcher_dir temporary
	launcher="${PRJ_ROOT}/.devenv/devenv-profile-exec"
	launcher_dir="${launcher%/*}"
	[[ -d "${launcher_dir}" ]] || return 0

	temporary="${launcher}.tmp.$$"
	(
		umask 077
		cat >"${temporary}" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

launcher_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "${launcher_dir}/.." && pwd -P)"
state_root="${launcher_dir}/state/direnv-profile-session"

run_request() {
	local request_dir status
	request_dir="$1"
	(
		local -a argv=()
		while IFS= read -r -d '' argument; do
			argv+=("${argument}")
		done < "${request_dir}/argv"
		if (( ${#argv[@]} == 0 )); then
			printf 'missing command\n' > "${request_dir}/stderr"
			status=2
		else
			cd -- "${repo_root}"
			set +e
			"${argv[@]}" < "${request_dir}/stdin" > "${request_dir}/stdout" 2> "${request_dir}/stderr"
			status=$?
			set -e
		fi
		printf '%s\n' "${status}" > "${request_dir}/status.tmp"
		mv -f -- "${request_dir}/status.tmp" "${request_dir}/status"
		: > "${request_dir}/done"
	) &
}

if [[ "${1:-}" == --server ]]; then
	[[ $# == 2 ]] || exit 2
	state_root="$2"
	requests="${state_root}/requests"
	while :; do
		for request_dir in "${requests}"/*; do
			[[ -d "${request_dir}" && -f "${request_dir}/argv" && ! -e "${request_dir}/done" ]] || continue
			mkdir -- "${request_dir}/running" 2>/dev/null || continue
			run_request "${request_dir}"
		done
		sleep 0.05
	done
fi

if (( $# == 0 )); then
	printf 'usage: %s <command> [args...]\n' "$0" >&2
	exit 2
fi

pid_file="${state_root}/pid"
if [[ ! -r "${pid_file}" ]] || ! kill -0 "$(<"${pid_file}")" 2>/dev/null; then
	printf '[devenv-profile-exec] no live direnv session; reactivate the workspace with direnv\n' >&2
	exit 75
fi

requests="${state_root}/requests"
temporary="$(mktemp -d "${requests}/.request.XXXXXX")"
request_dir="${requests}/request.$$.$RANDOM"
cleanup() { rm -rf -- "${temporary}" "${request_dir}"; }
trap cleanup EXIT INT TERM
printf '%s\0' "$@" > "${temporary}/argv"
: > "${temporary}/stdin"
mv -- "${temporary}" "${request_dir}"
temporary=""
while [[ ! -e "${request_dir}/done" ]]; do
	sleep 0.05
done
cat -- "${request_dir}/stdout"
cat -- "${request_dir}/stderr" >&2
status="$(<"${request_dir}/status")"
exit "${status}"
EOF
		chmod 700 -- "${temporary}"
		mv -f -- "${temporary}" "${launcher}"
		rm -f -- "${launcher}.sh"
	)
}

_prj_start_devenv_profile_session() {
	local launcher state_root previous_pid
	launcher="${PRJ_ROOT}/.devenv/devenv-profile-exec"
	state_root="${PRJ_ROOT}/.devenv/state/direnv-profile-session"
	[[ -x "${launcher}" ]] || return 1
	mkdir -p -- "${state_root}/requests"
	chmod 700 -- "${state_root}" "${state_root}/requests"
	previous_pid=""
	if [[ -r "${state_root}/pid" ]]; then
		previous_pid="$(<"${state_root}/pid")"
	fi
	if [[ -n "${previous_pid}" ]] && kill -0 "${previous_pid}" 2>/dev/null; then
		kill "${previous_pid}" 2>/dev/null || true
	fi
	rm -rf -- "${state_root}/requests"
	mkdir -p -- "${state_root}/requests"
	chmod 700 -- "${state_root}/requests"
	nohup "${launcher}" --server "${state_root}" >"${state_root}/server.log" 2>&1 < /dev/null &
	printf '%s\n' "$!" > "${state_root}/pid"
}

# Activate devenv when the project declares a devenv configuration.
if [[ -f "${PRJ_ROOT}/devenv.nix" || -f "${PRJ_ROOT}/devenv.yaml" ]]; then
	if ! command -v devenv >/dev/null 2>&1; then
		log_error "ERROR: devenv project detected but devenv is not available in PATH"
		return 1
	fi

	_prj_devenv_args=()
	if [[ -n "${DIRENV_PRJ_SILENCE+x}" ]]; then
		_prj_devenv_args+=(--quiet)
	fi

	eval "$(devenv direnvrc "${_prj_devenv_args[@]}")"

	if ((${#_prj_devenv_args[@]})); then
		# Calling the generated function directly also skips direnv's `using` log.
		use_devenv "${_prj_devenv_args[@]}"
	else
		use devenv
	fi

	_prj_write_devenv_profile_exec
	_prj_start_devenv_profile_session
	unset _prj_devenv_args
fi
